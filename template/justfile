# die Werkzeuge kommen aus der Devshell (`nix develop` oder direnv)

# einzige Stelle der Versionsnummer, die Tags heißen v<version>
version := `sed -n 's/^[[:space:]]*\.version = "\(.*\)",/\1/p' build.zig.zon`

[private]
default:
    @just --list

# bauen (auch `nix build`, siehe `build.command` in packages.nix)
[group("Entwicklung")]
build:
    zig build -Doptimize=ReleaseSafe

# Tests (auch `nix build`, siehe `build.checkCommand` in packages.nix)
[group("Entwicklung")]
test:
    zig build test

# geführt bei der Forge (`forge` in flake.nix) anmelden; das Token speichert gh bzw. tea
[group("Forge")]
forge-login:
    nix run .#branch-protection -- login

# Schutzregel für master auf der Forge anlegen oder aktualisieren, meldet vorher an; wer allein
# arbeitet, kann den eigenen Pull Request nicht freigeben und nimmt `just branch-protect 0`
[group("Forge")]
branch-protect approvals="1":
    nix run .#branch-protection -- protect --approvals {{ approvals }}

# die Schutzregeln des Repos
[group("Forge")]
branch-protection:
    nix run .#branch-protection -- show

# Pull Requests (Workflow „Prüfen und bauen“): Build mit Tests, NixOS-Modul, HTTP/3, Formatierung, YAML
[group("CI/CD")]
ci:
    nix flake check -L

# die Release-Dateien in dist/ (<paket>[-<datei>]-<tag>[-<ziel>]), welche es sind, steht in
# packages.nix (`release`)
[group("CI/CD")]
dist:
    #!/usr/bin/env bash
    set -euo pipefail
    out=$(nix build --no-link --print-out-paths .#dist)
    mkdir -p dist
    find dist -mindepth 1 -delete
    cp "$out"/* dist/

# ist die Version höher als der letzte Tag? (Workflows „Prüfen und bauen“ und „Release“)
[group("CI/CD")]
release-check:
    nix run .#project-release -- check

# Tag v<version> setzen und Release mit den Dateien aus `just dist` anlegen (Workflow „Release“ nach jedem Merge, braucht RELEASE_TOKEN)
[group("CI/CD")]
release: release-check dist
    nix run .#project-release -- publish
